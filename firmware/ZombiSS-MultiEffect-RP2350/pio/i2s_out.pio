; PIO program for I2S output to PCM5102 DAC
; 32-bit stereo, MSB-first, I2S Philips standard
; BCK and LRCK generated by PIO, data clocked out on rising BCK edge
;
; Pin mapping:
;   side-set pin 0 = BCK  (bit clock)
;   side-set pin 1 = LRCK (word select / left-right clock)
;   out pin 0      = DIN  (serial data)
;
; Autopull with 32-bit threshold: firmware pushes L then R words.
; LRCK low = Left channel, LRCK high = Right channel

.program i2s_out
.side_set 2

; Each bit takes 2 PIO cycles (low BCK + high BCK)
; 32 bits per channel, 2 channels = 64 bits per frame
; At 150 MHz sys_clk with clkdiv, we target 48kHz * 64 = 3.072 MHz BCK

                    ;        BCK  LRCK
.wrap_target
    ; --- LEFT CHANNEL (LRCK = 0) ---
    set x, 30       side 0b00  ; x = 30 (31 iterations for bits 31..1)
left_loop:
    out pins, 1     side 0b00  ; Output bit on falling BCK, LRCK low
    jmp x-- left_loop  side 0b10  ; Rising BCK edge clocks data into DAC
    out pins, 1     side 0b00  ; Bit 0 of left channel
    nop             side 0b10  ; Last rising edge for left

    ; --- RIGHT CHANNEL (LRCK = 1) ---
    set x, 30       side 0b01  ; x = 30, LRCK goes high
right_loop:
    out pins, 1     side 0b01  ; Output bit, LRCK high
    jmp x-- right_loop  side 0b11  ; Rising BCK
    out pins, 1     side 0b01  ; Bit 0 of right channel
    nop             side 0b11  ; Last rising edge for right
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void i2s_out_program_init(PIO pio, uint sm, uint offset,
                                         uint data_pin, uint bck_pin) {
    // data_pin = DIN, bck_pin = BCK, bck_pin+1 = LRCK
    pio_sm_config c = i2s_out_program_get_default_config(offset);

    // OUT pin: serial data
    sm_config_set_out_pins(&c, data_pin, 1);
    // Side-set pins: BCK and LRCK
    sm_config_set_sideset_pins(&c, bck_pin);

    // Configure pin directions
    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, bck_pin);
    pio_gpio_init(pio, bck_pin + 1);
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, bck_pin, 2, true);

    // Shift 32 bits, MSB first, autopull
    sm_config_set_out_shift(&c, false, true, 32);

    // FIFO join TX for deeper buffer
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    // Clock divider: target BCK = sample_rate * 64
    // PIO runs at 2 * BCK (2 cycles per bit)
    // clkdiv = sys_clk / (sample_rate * 64 * 2)
    float sys_clk = (float)clock_get_hz(clk_sys);
    float target = 48000.0f * 64.0f * 2.0f;
    sm_config_set_clkdiv(&c, sys_clk / target);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
